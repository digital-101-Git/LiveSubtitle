# Only listed source-release entries are eligible for tracking at the root.
# This working folder also contains installed runtimes and personal data.
/*
!/.gitignore
!/.gitattributes
!/.github/
/.github/*
!/.github/CODEOWNERS
!/LICENSE
!/README.md
!/LiveSubtitle.md
!/README.txt
!/SOURCE_RELEASE.txt
!/THIRD_PARTY_NOTICES.txt
!/license-assets/
!/API.txt
!/build.ps1
!/src/
!/engine/
!/0_UserManual(사용자매뉴얼)/
!/models/

# Include verified metadata only, never model weights.
/models/*
!/models/asr/
!/models/translation/
/models/asr/*
!/models/asr/qwen3-asr-1.7b/
!/models/asr/whisper-large-v3-turbo/
/models/asr/qwen3-asr-1.7b/*
!/models/asr/qwen3-asr-1.7b/config.json
!/models/asr/qwen3-asr-1.7b/generation_config.json
!/models/asr/qwen3-asr-1.7b/processor_config.json
!/models/asr/qwen3-asr-1.7b/tokenizer.json
!/models/asr/qwen3-asr-1.7b/tokenizer_config.json
!/models/asr/qwen3-asr-1.7b/chat_template.jinja
!/models/asr/qwen3-asr-1.7b/README.md
!/models/asr/qwen3-asr-1.7b/LICENSE*
!/models/asr/qwen3-asr-1.7b/NOTICE*
!/models/asr/qwen3-asr-1.7b/UPSTREAM*
!/models/asr/qwen3-asr-1.7b/모델다운로드.md
/models/asr/whisper-large-v3-turbo/*
!/models/asr/whisper-large-v3-turbo/config.json
!/models/asr/whisper-large-v3-turbo/preprocessor_config.json
!/models/asr/whisper-large-v3-turbo/tokenizer.json
!/models/asr/whisper-large-v3-turbo/vocabulary.json
!/models/asr/whisper-large-v3-turbo/README.md
!/models/asr/whisper-large-v3-turbo/LICENSE*
!/models/asr/whisper-large-v3-turbo/NOTICE*
!/models/asr/whisper-large-v3-turbo/UPSTREAM*
!/models/asr/whisper-large-v3-turbo/모델다운로드.md
/models/translation/*
!/models/translation/모델다운로드.md

# Defense in depth: weights, executables, credentials and build caches.
*.safetensors
*.gguf
*.ggml
*.bin
*.pt
*.pth
*.ckpt
*.onnx
*.nemo
*.h5
*.exe
*.dll
*.pdb
*.deps.json
*.runtimeconfig.json

**/bin/
**/obj/
**/__pycache__/
**/.pytest_cache/
*.py[cod]
**/.venv/
**/.vs/
*.user
*.suo
*.log
.env
.env.*
!.env.example
*[Tt]oken.txt
*.pem
*.key

